# GoHighLevel private integration token (Settings > Private Integrations).
# Scopes: contacts.readonly, contacts.write, opportunities.readonly, opportunities.write
GHL_TOKEN=
# Your sub-account (location) ID: the part after /location/ in the GoHighLevel address bar
GHL_LOCATION_ID=

# Optional: name of the pipeline to use (needs stages starting with Hot, Warm, Cold and Spam)
# GHL_PIPELINE_NAME=AI Speed-to-Lead

# Optional: n8n login and Gemini key, if not set in your shell
# N8N_URL=http://localhost:5678
# N8N_EMAIL=
# N8N_PASSWORD=
# GEMINI_API_KEY=
